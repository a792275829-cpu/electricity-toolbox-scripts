{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "电力工具箱",
  "version": "0.1.6",
  "identifier": "com.electricity.toolbox",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "电力工具箱 · 应用更新",
        "visible": false,
        "width": 680,
        "height": 480,
        "minWidth": 520,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "电力数据采集、分析与报表工具箱",
    "resources": {
      "payload/": "payload/"
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RjlERTU3MEVFNEQwRTIKUldUaTBPUU9WOTc1dDZRWXMwclh5YUxxYkhtQmRXUE5uaDc4bTdRMGx1d0x4WmdVSXBBalV2N3gK",
      "endpoints": [
        "https://github.com/a792275829-cpu/electricity-toolbox-scripts/releases/latest/download/latest.json"
      ]
    }
  }
}
