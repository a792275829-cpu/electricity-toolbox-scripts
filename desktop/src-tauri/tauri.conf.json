{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "电力工具箱",
  "version": "0.1.23",
  "identifier": "com.electricity.toolbox",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "电力工具箱 · 启动故障",
        "visible": false,
        "width": 680,
        "height": 480,
        "minWidth": 520,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "电力数据采集、分析与报表工具箱",
    "resources": {
      "payload/": "payload/"
    },
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {}
}
